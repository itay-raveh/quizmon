{
  "name": "quizmon",
  "version": "1.0.0",
  "private": true,
  "description": "The ultimate Pok\u00e9mon knowledge test",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "npm run items:prepare && npm run avatars:prepare && tsc --noEmit && vite build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "check:dead-code": "knip",
    "check:chart-wiring": "node tests/online/check-helm-chart.ts",
    "commitlint": "commitlint",
    "data:update": "node scripts/update-pokemon-data.ts",
    "avatars:prepare": "node scripts/update-trainer-avatars.ts",
    "items:prepare": "node scripts/prepare-item-sprites.ts",
    "avatars:update": "node scripts/update-trainer-avatars.ts --update",
    "deploy:dry-run": "npm run build:worker && wrangler deploy .wrangler/vite-worker/worker/index.js --config deploy/wrangler.json --dry-run --outdir .wrangler/dry-run",
    "dev": "node scripts/dev/start.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:push": "vitest run src/domain",
    "test:watch": "vitest",
    "dev:client": "npm run items:prepare && vite --host 127.0.0.1 --port 5173 --strictPort",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/dev/migrate.ts",
    "db:return-auth": "node server/return-auth-to-postgres.ts",
    "test:online": "node --test tests/online/account-config.test.ts tests/online/asset-headers.test.ts tests/online/catalog-schema.test.ts tests/online/prepare-worker-deploy.test.ts tests/online/release-config.test.ts tests/online/release-inputs.test.ts tests/online/sync-errors.test.ts",
    "test:accounts": "node --test tests/online/auth-session.test.ts && node tests/online/check-account-sync.ts",
    "test:sync": "npm run test:accounts && node tests/online/check-standings.ts && node tests/online/check-cutover-auth.ts && node tests/online/check-return-auth.ts && node --test tests/online/email.test.ts tests/online/email-budget.test.ts tests/online/trainer-summaries.test.ts tests/online/trainer-projection.test.ts",
    "generate:release-schema": "node scripts/generate-release-config-schema.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/gabarito": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/cloudflare": "^11.2.0",
    "@sentry/node": "11.2.0",
    "@sentry/react": "^11.2.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "fuse.js": "7.5.0",
    "hono": "4.13.12",
    "howler": "2.2.4",
    "input-otp": "^1.5.0",
    "jose": "6.2.12",
    "mongodb": "7.7.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-loading-skeleton": "^3.5.0",
    "react-share": "5.3.0",
    "rxdb": "17.5.0",
    "rxdb-server": "17.5.0",
    "seedrandom": "3.0.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261001.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@pkmn/dex": "0.10.11",
    "@playwright/test": "1.63.0",
    "@sentry/cli": "3.8.0",
    "@sentry/vite-plugin": "5.4.0",
    "@tanstack/router-plugin": "1.168.42",
    "@types/howler": "2.2.13",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/seedrandom": "3.0.8",
    "@types/web-push": "3.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "knip": "6.39.0",
    "marked": "18.0.14",
    "pokenode-ts": "3.0.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "workbox-cacheable-response": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "wrangler": "4.145.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "@sentry/cli": true
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        2,
        "never",
        [
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ]
    }
  },
  "knip": {
    "ignoreDependencies": [
      "@fontsource-variable/gabarito",
      "@fontsource-variable/martian-mono",
      "cloudflare"
    ],
    "workspaces": {
      ".": {
        "entry": [
          "server/auth-schema-config.ts",
          "server/instrument.ts",
          "deploy/migrate-release.ts",
          "worker/index.ts"
        ]
      }
    }
  },
  "prettier": {
    "singleQuote": true,
    "proseWrap": "never"
  }
}
