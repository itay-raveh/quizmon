{
  "name": "quizmon",
  "version": "1.0.0",
  "private": true,
  "description": "The ultimate Pokémon knowledge test",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check:dead-code": "knip",
    "commitlint": "commitlint",
    "data:update": "node scripts/update-pokemon-data.ts",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/gabarito": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@zumer/snapdom": "^2.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-share": "5.3.0",
    "use-sound": "5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "knip": "6.34.0",
    "pokenode-ts": "2.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "knip": {
    "ignoreDependencies": [
      "@fontsource-variable/gabarito",
      "@fontsource-variable/martian-mono"
    ]
  },
  "prettier": {
    "singleQuote": true
  }
}
