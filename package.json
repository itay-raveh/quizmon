{
  "name": "quizmon",
  "version": "1.0.0",
  "private": true,
  "description": "The ultimate Pokémon knowledge test",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run items:prepare && npm run avatars:prepare && tsc --noEmit && vite build",
    "check:dead-code": "knip",
    "check:chart-wiring": "node tests/online/check-helm-chart.ts",
    "commitlint": "commitlint",
    "data:update": "node scripts/update-pokemon-data.ts",
    "avatars:prepare": "node scripts/update-trainer-avatars.ts",
    "items:prepare": "node scripts/prepare-item-sprites.ts",
    "avatars:update": "node scripts/update-trainer-avatars.ts --update",
    "deploy:dry-run": "wrangler deploy --config deploy/wrangler.json --dry-run --outdir .wrangler/dry-run",
    "dev": "node scripts/dev/start.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:push": "vitest run src/domain",
    "test:watch": "vitest",
    "dev:client": "npm run items:prepare && vite --host 127.0.0.1 --port 5173 --strictPort",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/dev/migrate.ts",
    "test:online": "node --test tests/online/account-config.test.ts tests/online/asset-headers.test.ts tests/online/catalog-schema.test.ts tests/online/prepare-worker-deploy.test.ts tests/online/release-config.test.ts tests/online/release-inputs.test.ts",
    "test:accounts": "node tests/online/check-accounts.ts",
    "test:sync": "node tests/online/check-accounts.ts && node tests/online/check-restore.ts && node --test tests/online/email.test.ts tests/online/email-budget.test.ts",
    "generate:release-schema": "node scripts/generate-release-config-schema.ts"
  },
  "dependencies": {
    "@fontsource-variable/gabarito": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@powersync/web": "2.3.1",
    "@sentry/cloudflare": "^10.75.1",
    "@sentry/react": "^10.75.1",
    "@zumer/snapdom": "^2.24.15",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "fuse.js": "7.5.0",
    "hono": "4.13.7",
    "howler": "2.2.4",
    "input-otp": "^1.5.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.4.0",
    "react-share": "5.3.0",
    "seedrandom": "3.0.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260910.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@sentry/cli": "2.58.6",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/howler": "2.2.13",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/seedrandom": "3.0.8",
    "@types/web-push": "3.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "knip": "6.34.0",
    "marked": "18.0.11",
    "pokenode-ts": "2.3.0",
    "prettier": "3.9.6",
    "sharp": "0.35.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-cacheable-response": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "wrangler": "4.127.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "@sentry/cli": true
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        2,
        "never",
        [
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ]
    }
  },
  "knip": {
    "ignoreDependencies": [
      "@fontsource-variable/gabarito",
      "@fontsource-variable/martian-mono",
      "cloudflare"
    ],
    "workspaces": {
      ".": {
        "entry": [
          "server/auth-schema-config.ts",
          "deploy/migrate-release.ts",
          "worker/index.ts"
        ]
      }
    }
  },
  "prettier": {
    "singleQuote": true,
    "proseWrap": "never"
  }
}
