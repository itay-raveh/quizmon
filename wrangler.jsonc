{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quizmon",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1012",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "secrets": {
    "required": ["VAPID_PRIVATE_KEY"],
  },
  "exports": {
    "DailyReminder": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_REMINDERS",
        "class_name": "DailyReminder",
      },
    ],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sprites/*"],
  },
}
