{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quizmon",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "quizmon_events",
    },
  ],
}
