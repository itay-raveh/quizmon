{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quizmon",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 100, "subrequests": 50 },
  "kv_namespaces": [
    { "binding": "QUIZMON_SPENDING", "id": "d74e8bc9c72f4691a8595b2591adb7da" },
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "SPRITE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
  "secrets": {
    "required": ["VAPID_PRIVATE_KEY"],
  },
  "exports": {
    "DailyReminder": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_REMINDERS",
        "class_name": "DailyReminder",
      },
    ],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "quizmon_events",
    },
  ],
}
