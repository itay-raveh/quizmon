{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "releaseImage",
    "runtimeConfig",
    "inputs",
    "release",
    "powersync"
  ],
  "properties": {
    "releaseImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./_-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "runtimeConfig": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "workerName": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "origin": {
          "type": "string",
          "pattern": "^https://[^/@?#:]+(?:[.][^/@?#:]+)+$"
        },
        "sync": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^https://[^/@?#:]+(?:[.][^/@?#:]+)+$"
            },
            "audience": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["endpoint", "audience"],
          "additionalProperties": false
        },
        "hyperdriveId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{32}$"
        },
        "mailFrom": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "authRateLimitNamespace": {
          "type": "string",
          "pattern": "^[1-9]\\d*$"
        },
        "apiRateLimitNamespace": {
          "type": "string",
          "pattern": "^[1-9]\\d*$"
        }
      },
      "required": [
        "version",
        "workerName",
        "origin",
        "sync",
        "hyperdriveId",
        "mailFrom",
        "authRateLimitNamespace",
        "apiRateLimitNamespace"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrationConnection"],
      "properties": {
        "workerSecrets": {
          "$ref": "#/definitions/optionalSecretKey"
        },
        "migrationConnection": {
          "$ref": "#/definitions/secretKey"
        },
        "cloudflare": {
          "$ref": "#/definitions/optionalSecretKey"
        }
      }
    },
    "powersync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "sourceSecret", "storageSecret", "resources"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sourceSecret": {
          "$ref": "#/definitions/optionalSecretKey"
        },
        "storageSecret": {
          "$ref": "#/definitions/optionalSecretKey"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                },
                "ephemeral-storage": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                },
                "ephemeral-storage": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "sourceSecret": {
                "$ref": "#/definitions/secretKey"
              },
              "storageSecret": {
                "$ref": "#/definitions/secretKey"
              }
            }
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeDeadlineSeconds", "backoffLimit", "resources"],
      "properties": {
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                },
                "ephemeral-storage": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                },
                "ephemeral-storage": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "mode": {
          "enum": ["preflight", "deploy"]
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft-07/schema#",
  "definitions": {
    "secretKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key", "revision"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "optionalSecretKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key", "revision"],
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    }
  }
}
