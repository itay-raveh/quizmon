{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "quizmon-accounts-game-local",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 100,
    "subrequests": 50,
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1011",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1012",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "VAPID_PRIVATE_KEY"],
  },
  "vars": {
    "POWERSYNC_URL": "http://127.0.0.1:8089",
    "POWERSYNC_AUDIENCE": "quizmon-pilot",
    "AUTH_ORIGIN": "http://localhost:4188",
    "MAIL_DELIVERY": "test-mailbox",
    "MAIL_FROM": "",
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "hyperdrive": [
    {
      "binding": "ACCOUNT_DB",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:unused@127.0.0.1:5548/quizmon_pilot",
    },
  ],
  "exports": {
    "DailyReminder": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_REMINDERS",
        "class_name": "DailyReminder",
      },
    ],
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "quizmon_events",
    },
  ],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/sprites/*"],
  },
}
